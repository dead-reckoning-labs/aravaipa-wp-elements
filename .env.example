# Env vars read by scripts/ (the plugin itself reads none). Names only, never commit values.
# Several scripts read the claudeclaw root .env directly; keep real values there, not here.

# WordPress REST API (application passwords)
ARAVAIPA_WP_URL=
ARAVAIPA_WP_USER=
ARAVAIPA_WP_APP_PASSWORD=
ARAVAIPA_WP_ADMIN_USER=
ARAVAIPA_WP_ADMIN_APP_PASSWORD=

# Momentum live timing (fetch-results-from-timing.mjs)
MOMENTUM_TIMING_URL=
MOMENTUM_TIMING_USER=
MOMENTUM_TIMING_PASS=

# Media and shop
SMUGMUG_API_KEY=
YOUTUBE_API_KEY=
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=

# Set by ingest-photos.mjs when it runs photos-ingest.php through wp eval-file
ARV_INGEST_MODE=
ARV_INGEST_COMMIT=
ARV_INGEST_PAYLOAD=
